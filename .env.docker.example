# Settings for `docker compose up` / ./deploy.sh  (copy to .env). deploy.sh generates this file with random secrets.

# Public address users open in the browser. No trailing slash.
PUBLIC_URL=http://localhost
# Caddy site address:  ":80" = plain HTTP on PUBLIC_URL;  "auction.example.com" = automatic HTTPS for that domain.
CADDY_SITE=:80
# Host ports to publish. Change HTTP_PORT if 80 is taken (then PUBLIC_URL must include the port, e.g. http://localhost:8080).
HTTP_PORT=80
HTTPS_PORT=443

# Secrets. Generate with: openssl rand -hex 32
PG_PASSWORD=change-me
JWT_SECRET=change-me-must-be-at-least-32-random-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-min-10-chars

# password (default) | username_only (dev only, refused in production)
AUTH_MODE=password
# true = load the demo campaign and users on first start
SEED_DEMO=false
AUTO_BID_DELAY_MS=1000
