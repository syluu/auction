{
  "name": "auction",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm --filter @auction/shared build && pnpm -r --filter ./apps/* build",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:migrate": "pnpm --filter @auction/api prisma:migrate",
    "db:seed": "pnpm --filter @auction/api seed",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.0.9"
}
